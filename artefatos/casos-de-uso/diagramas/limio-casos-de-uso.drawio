        <mxCell id="p7e7" edge="1" parent="1" source="p7_UC13" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;strokeColor=#333333;edgeStyle=none;fontSize=10;labelBackgroundColor=#FFFFFF;" target="p7_UC47" value="«include»">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p7n0" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF9C4;strokeColor=#E0B000;size=14;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;" value="Avaliação é opcional (UC46) e não bloqueia o uso da plataforma. Sem nenhuma nota, o perfil exibe “sem avaliações”, nunca 0,0." vertex="1">
          <mxGeometry height="40" width="440" x="220" y="320" as="geometry" />
        </mxCell>
        <mxCell id="VdsNPutbHAy7teK609a1-1" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF9C4;strokeColor=#E0B000;size=14;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;" value="&lt;p dir=&quot;ltr&quot;&gt;&lt;strong&gt;Preenchimento das elipses&lt;/strong&gt;&lt;/p&gt;&lt;p dir=&quot;ltr&quot;&gt;■ &lt;strong&gt;Amarelo&lt;/strong&gt;&amp;nbsp;- caso de uso iniciado por um ator humano (Visitante, Usuário, Empregador, Prestador, Administrador).&lt;br&gt;&lt;br&gt;■ &lt;strong&gt;Verde&lt;/strong&gt;&amp;nbsp;- caso de uso executado automaticamente pelo &lt;strong&gt;Sistema&lt;/strong&gt;: jobs agendados, motor de match, contador de cota, webhook do gateway. Não existe clique humano no fluxo principal.&lt;br&gt;&lt;br&gt;■ &lt;strong&gt;Cinza tracejado&lt;/strong&gt;&amp;nbsp;- caso de uso de outro pacote, desenhado aqui só para mostrar o relacionamento, a especificação dele vive na página do pacote de origem.&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="380" x="220" y="370" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
